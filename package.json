{
  "name": "calligram",
  "version": "0.1.1",
  "description": "Flow text inside closed SVG paths — a small, fast text-layout layer on top of Pretext",
  "keywords": [
    "calligram",
    "text",
    "layout",
    "svg",
    "path",
    "pretext",
    "typography",
    "generative-art"
  ],
  "author": {
    "name": "Bairui SU",
    "url": "https://github.com/pearmini"
  },
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "dist/calligram.umd.min.js",
  "jsdelivr": "dist/calligram.umd.min.js",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pearmini/calligram.git"
  },
  "bugs": {
    "url": "https://github.com/pearmini/calligram/issues"
  },
  "homepage": "https://github.com/pearmini/calligram#readme",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && rollup -c",
    "preview": "vite preview",
    "test": "npm run test:js && npm run test:lint && npm run test:format",
    "test:js": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run --update",
    "test:lint": "eslint src test demo script",
    "test:format": "prettier --check src test demo script",
    "build:logo": "node script/build-logo.js",
    "screenshot": "node script/screenshot.js",
    "build:site": "vite build --mode site",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.4",
    "hachure-fill": "^0.5.2",
    "points-on-path": "^0.2.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "clipper-lib": "^6.4.2",
    "d3": "^7.9.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "js-beautify": "^1.15.4",
    "jsdom": "^26.1.0",
    "ml5": "^1.3.1",
    "patch-package": "^8.0.1",
    "playwright-core": "^1.65.1",
    "prettier": "^3.8.1",
    "rollup": "^4.68.9",
    "svgpath": "^2.6.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
